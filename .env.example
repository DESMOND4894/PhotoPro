# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_CAPTAIN_PHONE=your-captain-phone-number

# WhatsApp Group IDs (set after creating groups)
WHATSAPP_GROUP_CELTIC_QUEST_IV=group-id-here
WHATSAPP_GROUP_CELTIC_GRACE=group-id-here

# Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key

# Facebook / Instagram (Meta Graph API)
META_PAGE_ACCESS_TOKEN=your-page-access-token
META_PAGE_ID=your-facebook-page-id
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-account-id

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# App Config
NEXT_PUBLIC_APP_URL=https://photos.celticquestfishing.com
CRON_SECRET=your-cron-secret
